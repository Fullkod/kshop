{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_PLATFORM_DOMAIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SUPABASE_SECRET_KEY", "PLATFORM_CANONICAL_DOMAIN", "KSHOP_STORE", "KSHOP_API_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "codegen": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["SUPABASE_SECRET_KEY", "KSHOP_DB_TARGET", "KSHOP_LOCAL_DB_URL"]
    }
  }
}
