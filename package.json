{
  "name": "kshop",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@kshop/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "format": "prettier --write .",
    "codegen": "pnpm --filter @kshop/data codegen",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:query": "node scripts/db.mjs query",
    "db:auth-config": "node scripts/db.mjs auth-config",
    "db:graphql-schema": "node scripts/db.mjs graphql-schema",
    "test:rls": "node scripts/db.mjs test",
    "superadmin:create": "node scripts/create-superadmin.mjs",
    "e2e:setup": "node scripts/e2e.mjs setup",
    "e2e:api": "node scripts/e2e.mjs api",
    "e2e:cleanup": "node scripts/e2e.mjs cleanup",
    "demo:seed": "node scripts/seed-demo-store.mjs",
    "e2e:catalog": "node scripts/e2e-catalog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@supabase/supabase-js": "^2.118.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.0.0",
    "graphql": "^16.11.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  }
}
