# Copy to .env.local at the REPO ROOT (git-ignored) and fill with your own values.
# apps/web/next.config.ts and scripts/*.mjs read this single file.

# Agent tooling
TASKNIC_API_KEY=            # Tasknic key of THIS repo (never another project's)
SUPABASE_ACCESS_TOKEN=      # Supabase Dashboard -> Account -> Access Tokens (MCP + scripts/db.mjs)
SUPABASE_PROJECT_REF=       # Kshop's own Supabase project (never klauShop's)
SUPABASE_TEST_PROJECT_REF=  # "KShop Test" project: dev, e2e, qa and RLS tests go there by default (docs/TEST_DB.md)
# KSHOP_DB_TARGET=test      # test (default when SUPABASE_TEST_PROJECT_REF is set) | prod

# App
NEXT_PUBLIC_SUPABASE_URL=               # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... (browser and mobile apps)
SUPABASE_SECRET_KEY=                    # sb_secret_... (server only, bypasses RLS)
NEXT_PUBLIC_PLATFORM_DOMAIN=kshop.localhost:3000   # production: kshop.fullkod.com
# PLATFORM_CANONICAL_DOMAIN=kshop.fullkod.com      # domain stored in store_domains (default)
# KSHOP_CUSTOM_DOMAIN_REDIRECT=off   # Vercel: skip the subdomain -> custom domain lookup while no store has one live
# ELTOQUE_API_TOKEN=                    # optional: elTOQUE rates API (suggested rate in Admin › Monedas)
# Custom domains (phase 6.4): without the token they run in dry_run (simulated, verified on the first check).
# VERCEL_DOMAINS_TOKEN=                 # Vercel token with access to the project
# VERCEL_DOMAINS_PROJECT_ID=            # prj_...
# VERCEL_DOMAINS_TEAM_ID=               # team_... (if the project is in a team)

# E2E test accounts (generated by `pnpm e2e:setup`)
# E2E_SUPERADMIN_PASSWORD=
# E2E_OWNER_PASSWORD=

# Phase 8: klauShop migration source (read only; scripts/klaushop/*). Token of the klauShop Supabase ACCOUNT, used
# only inside `read only` transactions. Never put klauShop's service_role or database URL here.
# KLAUSHOP_PROJECT_REF=
# KLAUSHOP_ACCESS_TOKEN=
# KLAUSHOP_STORAGE_PUBLIC_URL=https://<klaushop-ref>.supabase.co/storage/v1/object/public/klaushop
